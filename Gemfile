source "https://rubygems.org"

# Local preview toolchain. GitHub Pages builds the live site with its own
# pinned Jekyll, so this file is only used when you run the site locally
# (`bundle exec jekyll serve`). The plugins below match _config.yml.
gem "jekyll", "~> 4.3"

group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17"
  gem "jekyll-seo-tag", "~> 2.8"
end

# A Ruby stdlib gem that newer Rubies no longer bundle; needed by `jekyll serve`.
gem "webrick", "~> 1.8"
